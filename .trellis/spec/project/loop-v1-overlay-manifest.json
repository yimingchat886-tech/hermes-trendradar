{
  "manifest_schema_version": 3,
  "release_model": "unified-intent-loop-v1",
  "trellis_base_version": "0.6.14",
  "entries": [
    {"owner": "overlay", "path": ".gitignore", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/.gitignore", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/workflow.md", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/scripts/task.py", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/scripts/prd.py", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/scripts/common", "scope": "tree"},
    {"owner": "overlay", "path": ".trellis/scripts/taskrun", "scope": "tree"},
    {"owner": "overlay", "path": ".trellis/scripts/tests", "scope": "tree"},
    {"owner": "overlay", "path": ".trellis/releases/check-catalog.json", "scope": "file"},
    {"owner": "overlay", "path": ".trellis/spec/guides", "scope": "tree"},
    {"owner": "overlay", "path": ".trellis/spec/project", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-before-dev", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-brainstorm", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-check", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-continue", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-finish-work", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-loop-v1", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-meta", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-session-insight", "scope": "tree"},
    {"owner": "overlay", "path": ".agents/skills/trellis-start", "scope": "tree"},
    {"owner": "overlay", "path": ".codex/agents", "scope": "tree"},
    {"owner": "overlay", "path": ".codex/hooks", "scope": "tree"},
    {"owner": "overlay", "path": ".claude/settings.json", "scope": "file"},
    {"owner": "overlay", "path": ".claude/hooks/impact_gate.py", "scope": "file"},
    {"owner": "overlay", "path": ".claude/hooks/impact_marker.py", "scope": "file"},
    {"owner": "overlay", "path": ".claude/hooks/scope_gate.py", "scope": "file"},
    {"owner": "overlay", "path": ".claude/hooks/session_start.py", "scope": "file"},
    {"owner": "project", "path": ".trellis/config.yaml", "scope": "file"},
    {"owner": "project", "path": ".trellis/tasks", "scope": "tree"},
    {"owner": "project", "path": ".trellis/workspace", "scope": "tree"},
    {"owner": "project", "path": "AGENTS.md", "scope": "file"},
    {"owner": "project", "path": "CLAUDE.md", "scope": "file"},
    {"owner": "project", "path": "README.md", "scope": "file"},
    {"owner": "project", "path": "HANDOFF.md", "scope": "file"},
    {"owner": "generated", "path": "BOARD.md", "scope": "file"},
    {"owner": "generated", "path": "<git-common-dir>/trellis/harness.sqlite3", "scope": "external"}
  ],
  "deployment": {
    "source_id": "trellis-harness",
    "policy_schema_version": 3,
    "adoption_projection": ".trellis/deploy/adoption.json",
    "preserve": [
      ".trellis/config.yaml",
      ".trellis/tasks",
      ".trellis/workspace",
      ".trellis/.runtime",
      "AGENTS.md",
      "CLAUDE.md",
      "README.md",
      "HANDOFF.md"
    ],
    "intentional_deletions": [
      ".agents/skills/trellis-before-dev",
      ".agents/skills/trellis-brainstorm",
      ".agents/skills/trellis-check",
      ".agents/skills/trellis-continue",
      ".agents/skills/trellis-finish-work",
      ".agents/skills/trellis-loop-v1",
      ".agents/skills/trellis-meta",
      ".agents/skills/trellis-session-insight",
      ".agents/skills/trellis-start",
      ".claude/hooks/claim_guard.py",
      ".codex/agents",
      ".codex/hooks",
      ".trellis/scripts/add_session.py",
      ".trellis/scripts/board.py",
      ".trellis/scripts/common",
      ".trellis/scripts/conflict_checklist.py",
      ".trellis/scripts/downstream_deployer",
      ".trellis/scripts/get_context.py",
      ".trellis/scripts/legacy_importer.py",
      ".trellis/scripts/loop_v1",
      ".trellis/scripts/merge_protocol.md",
      ".trellis/scripts/migrate_active_task_b_pilot_cancellations.py",
      ".trellis/scripts/migrate_legacy_task_b_cancellations.py",
      ".trellis/scripts/state_cli.py",
      ".trellis/scripts/state_machine.py",
      ".trellis/scripts/taskrun",
      ".trellis/scripts/tests",
      ".trellis/scripts/upstream_release",
      ".trellis/spec/guides",
      ".trellis/spec/project",
      ".trellis/templates/v3"
    ]
  }
}
