{
  "schema_version": "1.4",
  "profile_id": "hermes-v1.4-douyin-sample",
  "profile_type": "hermes_runtime",
  "profile_mode": "sample",
  "project": "hermes-agent",
  "platform_scope": {
    "production_platforms": ["douyin"],
    "reject_non_production_platforms": true
  },
  "account_profile_ref": "file:profiles/examples/accounts.douyin.sample.json",
  "analysis_profile_ref": "file:profiles/examples/analysis.v1.4.sample.json",
  "transcription_profile_ref": "file:profiles/examples/transcription.v1.4.sample.json",
  "runtime_profile_ref": "file:profiles/examples/runtime.v1.4.sample.json",
  "feishu_profile_ref": "file:profiles/examples/feishu.v1.4.allowlist.sample.json",
  "schedule": {
    "enabled": true,
    "cadence": "daily",
    "timezone": "Asia/Shanghai",
    "trigger_time_ref": "env:HERMES_V14_DAILY_TRIGGER_TIME",
    "lock_scope": "date+profile_hash"
  },
  "retry": {
    "max_attempts": 2,
    "retryable_exit_codes": [1, 3, 4, 5, 6, 8, 9],
    "non_retryable_exit_codes": [2, 7, 10],
    "backoff_policy_ref": "env:HERMES_V14_RETRY_BACKOFF_POLICY"
  }
}
